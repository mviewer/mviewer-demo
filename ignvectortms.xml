<?xml version="1.0" encoding="UTF-8"?>
<config>
<application
    title="Exemple TMS avec les flux IGN"
    logo=""
    help=""
    style="css/themes/default.css"
    exportpng="false"
    showhelp="false"
    coordinates="false"
    measuretools="false"
    togglealllayersfromtheme="false">
</application>
<mapoptions maxzoom="18" projection="EPSG:3857" center="-324758.482762259,6050184.623044413" zoom="15" />
<olscompletion url="https://data.geopf.fr/geocodage/search/" type="ban" attribution="La recherche d'adresse est un service proposé par la geoplateforme IGN"/>
<searchparameters bbox="false" localities="true" features="false" static="false"/>
<baselayers style="default">
	<baselayer visible="false" id="osm_grey" thumbgallery="https://tile.geobretagne.fr/osm/tms/osm:grey/EPSG3857/16/64287/85957.png" title="OpenStreetMap Grey" label="OpenStreetMap Grey" type="WMTS" 
		url="https://tile.geobretagne.fr/osm/service" layers="osm:grey" format="image/png" matrixset="PM" fromcapacity="false" style="_null"
		attribution="GéoBretagne. Données : les contributeurs d'&lt;a href='https://www.openstreetmap.org/' target='_blank'>OpenStreetMap &lt;/a>,  &lt;a href='https://www.openstreetmap.org/copyright' target='_blank'>ODbL &lt;/a>"/>
	<baselayer  type="WMTS" id="ortho" label="Photo aérienne IGN" title="GéoPortail" thumbgallery="img/basemap/ortho.jpg"
		url="https://data.geopf.fr/wmts" layers="ORTHOIMAGERY.ORTHOPHOTOS" format="image/jpeg" visible="false" fromcapacity="false"
		attribution="&lt;a href='https://geoservices.ign.fr/services-geoplateforme-diffusion' target='_blank'>&lt;img src='img/basemap/geoservices.png'>&lt;/a>" style="normal" matrixset="PM" maxzoom="22"/>
    <baselayer visible="true" id="plan_ign" thumbgallery="img/basemap/plan_ign.png" title="Plan IGN" label="TMS Plan IGN" type="vector-tms" url="https://data.geopf.fr/tms/1.0.0/PCI/{z}/{x}/{y}.pbf" styleurl="https://data.geopf.fr/annexes/ressources/vectorTiles/styles/PLAN.IGN/standard.json" style="plan_ign" attribution="IGN"  ></baselayer>
</baselayers>
<themes mini="false">
    <theme name="Vecteur TMS"  collapsed="false" id="vtms" icon="far fa-file-alt">
        <layer
            id="adminExpress"
            name="Admin Express"
            visible="false"
            type="vector-tms"
            opacity="0.9"
            queryable="true"
            filterstyle=""
            maxzoom="15"
            styleurl="https://data.geopf.fr/annexes/ressources/vectorTiles/styles/ADMIN_EXPRESS/adminexpress.json"
            infopanel="right-panel"
            legendurl=""
            metadata="https://geoservices.ign.fr/services-geoplateforme"
            attribution="Source: IGN"
            style="adminexpress"
            url="https://data.geopf.fr/tms/1.0.0/ADMIN_EXPRESS/{z}/{x}/{y}.pbf">
            <template url="demo/ignvectortms.mst"></template>
        </layer>
        <layer
            id="pciign"
            name="PCI"
            visible="true"
            type="vector-tms"
            opacity="0.9"
            queryable="true"
            filterstyle="borne_limite_propriete"
            maxzoom="15"
            styleurl="https://data.geopf.fr/annexes/ressources/vectorTiles/styles/PCI/pci.json"
            infopanel="right-panel"
            legendurl=""
            metadata="https://geoservices.ign.fr/services-geoplateforme"
            attribution="Source: IGN"
            style="pci"
            url="https://data.geopf.fr/tms/1.0.0/PCI/{z}/{x}/{y}.pbf">
        </layer>
    </theme>
</themes>
</config>
