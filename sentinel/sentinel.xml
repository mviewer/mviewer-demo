		url="https://tile.geobretagne.fr/osm/service" layers="osm:grey" format="image/png" matrixset="PM" fromcapacity="false" style="_null"
		attribution="GéoBretagne. Données : les contributeurs d'&lt;a href='https://www.openstreetmap.org/' target='_blank'>OpenStreetMap &lt;/a>,  &lt;a href='https://www.openstreetmap.org/copyright' target='_blank'>ODbL &lt;/a>"/>
</baselayers>
<themes mini="true" legendmini="false">
    <theme name="Je saisis..."  collapsed="false" id="demo" icon="fas fa-cog">
        <layer id="sentinel" name="Mes critères de séléction d'image" visible="true" queryable="false"
            legendurl="https://www.sentinel-hub.com/img/logo.svg"
            type="customlayer"
            customcontrolpath="demo/sentinel/control"
            opacity="1"
            url="demo/sentinel/layer/sentinel.js"
            customcontrol="true"
            expanded="true"
            metadata=""
            metadata-csw="">
        </layer>
    </theme>
</themes>
